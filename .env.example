# Public address. Do not include a path.
MIRROR_DOMAIN=mirror.funmig.com
DJANGO_ALLOWED_HOSTS=mirror.funmig.com,localhost,127.0.0.1
DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=false

# May be any mounted host directory; Docker maps it to /data/mirror in services.
MIRROR_STORAGE_ROOT=/data/mirror
MIRROR_REPOSITORY_ROOT=/data/mirror/repositories
GIT_REPOSITORY_ROOT=/media/arshia/New Volume1/git repo
TOTAL_STORAGE_LIMIT_GB=500
PYPI_STORAGE_LIMIT_GB=220
NPM_STORAGE_LIMIT_GB=170
TEMP_STORAGE_LIMIT_GB=10
MIN_FREE_DISK_GB=25
STORAGE_WARNING_PERCENT=80
STORAGE_CRITICAL_PERCENT=90
STORAGE_EMERGENCY_PERCENT=95
KEEP_LATEST_PYPI_VERSIONS=5
KEEP_CRITICAL_PYPI_VERSIONS=10
PYPI_UPSTREAM=https://pypi.org
UPSTREAM_MODE=auto
